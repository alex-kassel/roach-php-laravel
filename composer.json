{
    "name": "alex-kassel/roach-php-laravel",
    "description": "Laravel adapter for roach-php/core web scraping toolkit",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "scraping",
        "crawler",
        "spider",
        "scraper",
        "roach",
        "roach-php"
    ],
    "homepage": "https://github.com/alex-kassel/roach-php-laravel",
    "support": {
        "issues": "https://github.com/alex-kassel/roach-php-laravel/issues",
        "source": "https://github.com/alex-kassel/roach-php-laravel"
    },
    "authors": [
        {
            "name": "Kai Sassnowski",
            "email": "me@kai-sassnowski.com",
            "role": "Original Author"
        },
        {
            "name": "Alexander Macenko",
            "email": "alexander.macenko@gmail.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
        "alex-kassel/roach-php-core": "^1.0",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.11"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0",
        "roave/security-advisories": "dev-latest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "RoachPHP\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoachPHP\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoachPHP\\Laravel\\RoachServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyze": "vendor/bin/phpstan analyse src",
        "test": "vendor/bin/phpunit"
    }
}
